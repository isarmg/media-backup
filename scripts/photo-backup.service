[Unit]
Description=Photo backup server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/mnt/sarmg.org/photo-backup
EnvironmentFile=/mnt/sarmg.org/photo-backup/.env
ExecStart=/mnt/sarmg.org/photo-backup/target/release/photo-backup-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
