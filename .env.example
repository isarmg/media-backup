DATABASE_URL=sqlite:///var/lib/isarmg/photo-backup/db/app.db
DATA_DIR=./data
BIND=127.0.0.1:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
MAX_PART_BYTES=67108864
REQUIRE_HTTPS=true
DEVELOPMENT=false
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=43200
METRICS_TOKEN=replace-with-a-separate-long-random-token
RUST_LOG=photo_backup_server=info,tower_http=info
